#!/usr/bin/env bash
# This is a quality-of-life script surrounding the quick spin-up of a worktree
# off of a thought. I.e. you'd invoke `s-git-feat` with a desire to do something; this script then:
# - Figures out a branch/worktree name for that thing.
# - Figures out which repository you would have been referred to. Pays to be clear, though.
# - Sets up a worktree, jumps into it, spins up opencode and shoots off the
#   initial prompt (presumed to be "Plan" mode.)
# - Spawns 3 kitty windows with tmux sessions inside, then remote-controls them.

set -euo pipefail

# --- Cleanup trap: kill tmux sessions on error ---
CLEANUP_DONE=false
cleanup() {
    if $CLEANUP_DONE; then
        return
    fi
    CLEANUP_DONE=true
    if [ -n "${NVIM_SESSION:-}" ] && tmux has-session -t "$NVIM_SESSION" 2>/dev/null; then
        tmux kill-session -t "$NVIM_SESSION" 2>/dev/null || true
    fi
    if [ -n "${OPENCODE_SESSION:-}" ] && tmux has-session -t "$OPENCODE_SESSION" 2>/dev/null; then
        tmux kill-session -t "$OPENCODE_SESSION" 2>/dev/null || true
    fi
    if [ -n "${SHELL_SESSION:-}" ] && tmux has-session -t "$SHELL_SESSION" 2>/dev/null; then
        tmux kill-session -t "$SHELL_SESSION" 2>/dev/null || true
    fi
}

# Untrap on success (if we don't make it to the end)
trap cleanup EXIT

# --- Colors (256-color palette) ---
RESET=$'\033[0m'
GREY_STD=$'\033[38;5;242m'
GREY_LIGHT=$'\033[38;5;252m'
GREY_DARK=$'\033[38;5;237m'
BOLD_BRIGHT_RED=$'\033[1;38;5;196m'
BOLD_BRIGHT_GREEN=$'\033[1;38;5;46m'
BOLD_BRIGHT_YELLOW=$'\033[1;38;5;226m'

DEBUG=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --debug)
            DEBUG=true
            set -x
            shift
            ;;
        *)
            break
            ;;
    esac
done

# --- Config ---
MODEL="${S_GIT_FEAT_MODEL:-qw3.5-2b-nonthinking-Q5_K_S-default-ctx256k}"
LLM_ENDPOINT="${S_GIT_FEAT_ENDPOINT:-http://localhost:8080/v1/chat/completions}"
REPOS_UNDER="${S_GIT_FEAT_REPODIR:-$HOME/repos}"
WORKTREES_UNDER="${S_GIT_FEAT_WORKTREE_DIR:-$HOME/worktrees}"

# --- 0. Spawn tmux sessions early (before any AI calls) ---
RANDOM_SUFFIX=$RANDOM
NVIM_SESSION="s-git-feat-${RANDOM_SUFFIX}-nvim"
OPENCODE_SESSION="s-git-feat-${RANDOM_SUFFIX}-opencode"
SHELL_SESSION="s-git-feat-${RANDOM_SUFFIX}-shell"

echo "${GREY_STD}🖥️  Spawning tmux sessions...${RESET}"
tmux new-session -d -s "$NVIM_SESSION" "$SHELL"
tmux new-session -d -s "$OPENCODE_SESSION" "$SHELL"
tmux new-session -d -s "$SHELL_SESSION" "$SHELL"

# Attach each session to a kitty window (attached mode)
kitty tmux attach-session -t "$NVIM_SESSION" &
kitty tmux attach-session -t "$OPENCODE_SESSION" &
kitty tmux attach-session -t "$SHELL_SESSION" &

echo "${GREY_STD}   ✓ tmux session: ${RESET}${GREY_LIGHT}$NVIM_SESSION${RESET}"
echo "${GREY_STD}   ✓ tmux session: ${RESET}${GREY_LIGHT}$OPENCODE_SESSION${RESET}"
echo "${GREY_STD}   ✓ tmux session: ${RESET}${GREY_LIGHT}$SHELL_SESSION${RESET}"
echo ""

# --- Helper: call AI endpoint ---
ai_query() {
    local user_msg="$1"
    local response
    response=$(curl -sS -X POST "$LLM_ENDPOINT" \
        -H "Content-Type: application/json" \
        --data "$(jq -nc --arg model "$MODEL" --arg msg "$user_msg" \
            '{model: $model, messages: [{role: "user", content: $msg}], max_tokens: 1000}')")
    
    if $DEBUG; then
        echo "📡 AI request: $user_msg" >&2
        echo "📥 AI response (raw): $response" >&2
    fi
    
    echo "$response" | jq -r '.choices[0].message.content'
}

# --- 1. Parse prompt ---
PROMPT="$*"
if [ -z "$PROMPT" ]; then
    echo "${BOLD_BRIGHT_RED}❌ No prompt provided${RESET}"
    echo "${GREY_STD}   Usage: s-git-feat <your feature description>${RESET}"
    echo ""
    echo "${GREY_STD}   Example: s-git-feat 'Add dark mode toggle to settings'${RESET}"
    exit 1
fi

echo "${GREY_STD}🚀 s-git-feat starting...${RESET}"
echo "${GREY_STD}   Prompt: ${RESET}$PROMPT"
echo ""

# --- 2. List all repos ---
REPOS=$(find "$REPOS_UNDER" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort -u | tr '\n' ',')
echo "${GREY_STD}📂 Found $(echo "$REPOS" | tr ',' '\n' | wc -l) repos in ${GREY_LIGHT}$REPOS_UNDER${RESET}"

# --- 3. Select repo (AI) ---
echo "${GREY_STD}🤖 Asking AI which repo to use...${RESET}"
SELECTED_REPO=$(ai_query "Output ONLY the repo name (no prefixes, no reasoning) from this list: $REPOS. Which repo is the user referring to in this prompt? \"$PROMPT\". If the user is specifying a repo, use that. If you're in doubt, do not output anything.")
SELECTED_REPO=$(echo "$SELECTED_REPO" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
echo "${GREY_STD}   AI selected: ${RESET}${BOLD_BRIGHT_YELLOW}$SELECTED_REPO${RESET}"
REPO_PATH="$REPOS_UNDER/$SELECTED_REPO"
if [ ! -d "$REPO_PATH" ]; then
    echo "${BOLD_BRIGHT_RED}❌ Repo '$SELECTED_REPO' not found at $REPO_PATH${RESET}" >&2
    exit 1
fi
echo "${BOLD_BRIGHT_GREEN}✅ Repo confirmed: ${RESET}$REPO_PATH"

# --- 4. Generate worktree name (AI) ---
echo "${GREY_STD}🤖 Asking AI to generate worktree name...${RESET}"
NAME=$(ai_query "Output ONLY a short, lowercase, hyphenated branch name for this feature: $PROMPT")
echo "${GREY_STD}   AI suggested: ${RESET}${BOLD_BRIGHT_YELLOW}$NAME${RESET}"

# --- 5. Validate name format ---
if ! echo "$NAME" | grep -qE '^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$'; then
    echo "${BOLD_BRIGHT_RED}❌ Generated name '$NAME' is not properly formatted (expected: lowercase, hyphenated)${RESET}" >&2
    exit 1
fi

# --- 6. Create worktree dir ---
DATE=$(date +%Y-%m-%d_%H_%M_%S)
WORKTREE_DIR="$WORKTREES_UNDER/${DATE}_${SELECTED_REPO}_${NAME}"
mkdir -p "$WORKTREE_DIR"
echo "${GREY_STD}📁 Created worktree: ${RESET}${GREY_LIGHT}$WORKTREE_DIR${RESET}"

# --- 7. Detect branch ---
cd "$REPO_PATH"
BRANCH=$(git branch --show-current 2>/dev/null || echo "main")
if [ "$BRANCH" != "main" ] && [ "$BRANCH" != "master" ]; then
    echo "${BOLD_BRIGHT_RED}❌ Unknown branch '$BRANCH' (expected 'main' or 'master')${RESET}" >&2
    exit 1
fi
echo "${GREY_STD}🌿 Detected branch: ${RESET}$BRANCH"

# --- 8. Create git worktree ---
echo "${GREY_STD}📦 Creating git worktree...${RESET}"
git worktree add -b "$NAME" "$WORKTREE_DIR" "$BRANCH"
echo "${BOLD_BRIGHT_GREEN}✅ Worktree created: ${RESET}${GREY_LIGHT}$WORKTREE_DIR${RESET}"

# --- 9. Generate random port ---
PORT=$((RANDOM % 10000 + 30000))
echo "${GREY_STD}🔌 Generated random port: ${RESET}$PORT"

# --- 10. Start opencode server (cd to worktree first) ---
echo "${GREY_STD}🚀 Starting opencode server...${RESET}"
cd "$WORKTREE_DIR"
opencode serve --port "$PORT" --hostname 127.0.0.1 &
OPENCODE_PID=$!
echo "${GREY_STD}   Server started (PID: ${RESET}$OPENCODE_PID${GREY_STD})${RESET}"
sleep 5
echo "${BOLD_BRIGHT_GREEN}✅ Opencode server ready: ${RESET}${GREY_LIGHT}http://127.0.0.1:$PORT${RESET}"

# --- 11. Create session and send prompt ---
echo "${GREY_STD}💬 Creating session and sending prompt...${RESET}"
SESSION_ID=$(curl -sS -X POST "http://127.0.0.1:$PORT/session" \
  -H "Content-Type: application/json" \
  --data "$(jq -nc --arg title "$NAME" '{title: $title}')" | jq -r '.id')
echo "${GREY_STD}   Session ID: ${RESET}${BOLD_BRIGHT_YELLOW}$SESSION_ID${RESET}"

[ -n "$SESSION_ID" ] || { echo "No session ID?"; exit 1; }

curl -sS -X POST "http://127.0.0.1:$PORT/session/$SESSION_ID/prompt_async" \
  -H "Content-Type: application/json" \
  --data "$(jq -nc --arg prompt "$PROMPT" '{parts: [{type: "text", text: $prompt}]}')"
echo "${BOLD_BRIGHT_GREEN}✅ Prompt sent to session${RESET}"

# --- 12. Remote-control tmux sessions ---
echo "${GREY_STD}🎮 Remote-controlling tmux sessions...${RESET}"

# Send cd + nvim to nvim session
tmux send-keys -t "$NVIM_SESSION" "cd $WORKTREE_DIR" C-m
tmux send-keys -t "$NVIM_SESSION" "nvim" C-m
echo "${GREY_STD}   ✓ Sent to ${RESET}${GREY_LIGHT}$NVIM_SESSION${GREY_STD}: cd $WORKTREE_DIR && nvim${RESET}"

# Send cd + opencode attach to opencode session
tmux send-keys -t "$OPENCODE_SESSION" "cd $WORKTREE_DIR" C-m
tmux send-keys -t "$OPENCODE_SESSION" "opencode attach \"http://127.0.0.1:$PORT\" --session \"$SESSION_ID\"" C-m
echo "${GREY_STD}   ✓ Sent to ${RESET}${GREY_LIGHT}$OPENCODE_SESSION${GREY_STD}: cd $WORKTREE_DIR && opencode attach...${RESET}"

# Send cd to shell session
tmux send-keys -t "$SHELL_SESSION" "cd $WORKTREE_DIR" C-m
echo "${GREY_STD}   ✓ Sent to ${RESET}${GREY_LIGHT}$SHELL_SESSION${GREY_STD}: cd $WORKTREE_DIR${RESET}"

trap - EXIT

echo ""
echo "${GREY_DARK}═══════════════════════════════════════════════════════════${RESET}"
echo "${BOLD_BRIGHT_GREEN}🎉 Setup complete!${RESET}"
echo ""
echo "${GREY_STD}   Worktree: ${RESET}${GREY_LIGHT}$WORKTREE_DIR${RESET}"
echo "${GREY_STD}   Repo:     ${RESET}${GREY_LIGHT}$REPO_PATH${GREY_STD} (branch: ${RESET}$BRANCH${GREY_STD})${RESET}"
echo "${GREY_STD}   Opencode: ${RESET}${GREY_LIGHT}http://127.0.0.1:$PORT${GREY_STD} (PID: ${RESET}$OPENCODE_PID${GREY_STD})${RESET}"
echo "${GREY_STD}   Session:  ${RESET}${BOLD_BRIGHT_YELLOW}$SESSION_ID${RESET}"
echo ""
echo "${GREY_STD}   📝 Prompt: ${RESET}$PROMPT"
echo ""
echo "${GREY_STD}   Three tmux sessions are now active in kitty windows:${RESET}"
echo "${GREY_STD}   • ${RESET}${GREY_LIGHT}$NVIM_SESSION${GREY_STD} - nvim${RESET}"
echo "${GREY_STD}   • ${RESET}${GREY_LIGHT}$OPENCODE_SESSION${GREY_STD} - opencode TUI${RESET}"
echo "${GREY_STD}   • ${RESET}${GREY_LIGHT}$SHELL_SESSION${GREY_STD} - shell${RESET}"
echo "${GREY_DARK}═══════════════════════════════════════════════════════════${RESET}"

